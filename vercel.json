{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "editor.js",
      "use": "@vercel/static"
    },
    {
      "src": "editor.css",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "Logo/**",
      "use": "@vercel/static"
    },
    {
      "src": "PageTurnImages/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(freehandnx|editor)",
      "dest": "/editor.html"
    },
    {
      "src": "/preview/([A-Za-z0-9_-]{6,64})",
      "dest": "/editor.html?share=$1&preview=1"
    },
    {
      "src": "/([A-Za-z0-9_-]{12})",
      "dest": "/editor.html?share=$1&preview=1"
    },
    {
      "src": "/([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})",
      "dest": "/editor.html?share=$1&preview=1"
    },
    {
      "src": "/preview",
      "dest": "/preview.html"
    },
    {
      "src": "/signup",
      "dest": "/signup.html"
    },
    {
      "src": "/auth-callback",
      "dest": "/auth-callback.html"
    },
    {
      "src": "/adminlogin",
      "dest": "/adminlogin.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/(pricing|faqs|help|contact|terms|privacy)",
      "dest": "/$1.html"
    },
    {
      "src": "/(editor\\.js|editor\\.css|styles\\.css|editor\\.html|preview\\.html|signup\\.html|auth-callback\\.html|favicon\\.ico|.*\\.(png|jpg|jpeg|svg|webp|gif))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
